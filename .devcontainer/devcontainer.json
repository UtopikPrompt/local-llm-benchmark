{
  "name": "local-llm-benchmark",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--network",
    "host"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.vscode-typescript-next",
        "Ollama.ollama"
      ]
    }
  },
  "mounts": [
    "source=cache,target=/home/vscode/.cache/pip,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
  "forwardPorts": [
    4317
  ],
  "remoteUser": "vscode"
}
