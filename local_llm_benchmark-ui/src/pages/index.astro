<script>
  import DefaultLayout from "../layouts/Default.astro";
  import { bridgeFetchRuns, bridgeGetScores } from "../bridge.js";

  export interface Runs {
    id: string;
    model: string;
    prompt: string | null;
    completion: string | null;
    qualityScores: Record<string, number>;
    createdAt: string;
  }

  export interface QualityScores {
    id: string;
    accuracy: number;
    faithfulness: number;
    groundedness: number;
    instructionFollowing: number;
    reasoning: number;
    relevance: number;
    helpfulness: number;
    honesty: number;
    harmlessness: number;
    qualityScores: Map<string, number>;
  }

  export interface QualityScoresForAveraging extends QualityScoresIndex {
    accuracy: number;
    faithfulness: number;
    groundedness: number;
    instructionFollowing: number;
    reasoning: number;
    relevance: number;
    helpfulness: number;
    honesty: number;
    harmlessness: number;
  }

  export interface QualityScoresIndex {
    [key: string]: number;
  }

  let runs: Runs[] = [];
  let qualityScores: Map<string, QualityScores> = new Map();

  let cachedRuns = false;

  async function fetchScores() {
    if (qualityScores.size > 0) return;

    try {
      const scoredRuns = await getScores();
      scoredRuns.forEach(
        (run: { id: string; qualityScores: Map<string, number> }) => {
          const qs = new Map<string, number>(run.qualityScores);
          const qualityScore: QualityScores = {
            id: run.id,
            qualityScores: qs,
            accuracy: 0,
            faithfulness: 0,
            groundedness: 0,
            instructionFollowing: 0,
            reasoning: 0,
            relevance: 0,
            helpfulness: 0,
            honesty: 0,
            harmlessness: 0,
          };
          qualityScores.set(run.id, qualityScore);
        },
      );
    } catch (error) {
      console.error("getScores error:", error);
    }
  }

  function getRunWithScores(run: Runs): Runs {
    const scoresObj = qualityScores.get(run.id);
    const scores: QualityScoresForAveraging = scoresObj
      ? {
          accuracy: scoresObj.accuracy,
          faithfulness: scoresObj.faithfulness,
          groundedness: scoresObj.groundedness,
          instructionFollowing: scoresObj.instructionFollowing,
          reasoning: scoresObj.reasoning,
          relevance: scoresObj.relevance,
          helpfulness: scoresObj.helpfulness,
          honesty: scoresObj.honesty,
          harmlessness: scoresObj.harmlessness,
        }
      : {
          accuracy: 0,
          faithfulness: 0,
          groundedness: 0,
          instructionFollowing: 0,
          reasoning: 0,
          relevance: 0,
          helpfulness: 0,
          honesty: 0,
          harmlessness: 0,
        };
    return { ...run, qualityScores: scores as QualityScoresForAveraging };
  }

  function formatScore(score: number): string {
    return `${(score * 100).toFixed(1)}%`;
  }

  async function handleRefresh() {
    await fetchRuns();
    await fetchScores();
  }

  function formatDate(dateString: string): string {
    return new Date(dateString).toLocaleString();
  }

  function averageScore(scores: QualityScoresForAveraging): number {
    const metrics = [
      "accuracy",
      "faithfulness",
      "groundedness",
      "instructionFollowing",
      "reasoning",
      "relevance",
      "helpfulness",
      "honesty",
      "harmlessness",
    ];
    const total = metrics.reduce((sum, m) => sum + (scores[m] || 0), 0);
    return total / metrics.length;
  }

  async function fetchRuns(): Promise<Runs[]> {
    try {
      const runs = await bridgeFetchRuns();
      return runs.map((run: Runs) => ({
        run_id: run.id,
        model: run.model,
        prompt: run.prompt,
        completion: run.completion,
        id: run.id,
        qualityScores: run.qualityScores,
        createdAt: run.createdAt,
      }));
    } catch (error) {
      console.error("fetchRuns error:", error);
      return [];
    }
  }

  async function getScores(): Promise<QualityScores[]> {
    try {
      const scores = await bridgeGetScores();
      return scores.map(
        (score: { id: string; qualityScores: Map<string, number> }) => ({
          id: score.id,
          qualityScores: score.qualityScores,
          accuracy: 0,
          faithfulness: 0,
          groundedness: 0,
          instructionFollowing: 0,
          reasoning: 0,
          relevance: 0,
          helpfulness: 0,
          honesty: 0,
          harmlessness: 0,
        }),
      );
    } catch (error) {
      console.error("getScores error:", error);
      return [];
    }
  }

  let html = "";

  html = `<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Local LLM Benchmark</title>
</head>
<body>
  <main>
    <h1>Local LLM Benchmark</h1>
    <p>Cached benchmark runs from the Python backend.</p>
    
    <button id="refresh">🔄 Refresh</button>
    
    <div id="runs-container"></div>
    
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        line-height: 1.6;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        min-height: 100vh;
        color: #e0e0e0;
      }
      
      main {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
      }
      
      h1 {
        text-align: center;
        color: #64ffda;
        margin-bottom: 0.5rem;
        font-size: 2.5rem;
      }
      
      p {
        text-align: center;
        color: #a0aec0;
        margin-bottom: 2rem;
      }
      
      button {
        background: linear-gradient(135deg, #64ffda 0%, #38b2ac 100%);
        color: #1a1a2e;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(100, 255, 218, 0.3);
      }
      
      button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(100, 255, 218, 0.4);
      }
      
      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
      }
      
      #runs-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 1.5rem;
      }
      
      .run-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(100, 255, 218, 0.2);
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.3s ease;
      }
      
      .run-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(100, 255, 218, 0.2);
        border-color: rgba(100, 255, 218, 0.4);
      }
      
      .run-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
      }
      
      .run-title {
        font-size: 1.25rem;
        color: #64ffda;
        font-weight: 600;
        margin: 0;
      }
      
      .run-id {
        font-size: 0.75rem;
        color: #718096;
        font-family: monospace;
      }
      
      .run-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        font-size: 0.875rem;
        color: #a0aec0;
      }
      
      .run-meta span {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }
      
      .run-content {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
        max-height: 150px;
        overflow: hidden;
        position: relative;
      }
      
      .run-content::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #64ffda, transparent);
      }
      
      .run-content p {
        margin: 0;
        color: #cbd5e0;
        font-size: 0.875rem;
        line-height: 1.5;
      }
      
      .run-content p:first-child {
        color: #e2e8f0;
      }
      
      .run-content p:last-child {
        color: #a0aec0;
      }
      
      .run-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
      }
      
      .score-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
      }
      
      .score-item {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
      }
      
      .score-label {
        font-size: 0.625rem;
        color: #718096;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      
      .score-value {
        font-size: 0.875rem;
        font-weight: 600;
        color: #64ffda;
      }
      
      .score-bar {
        height: 4px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 2px;
        overflow: hidden;
      }
      
      .score-fill {
        height: 100%;
        background: linear-gradient(90deg, #64ffda, #38b2ac);
        border-radius: 2px;
        transition: width 0.5s ease;
      }
      
      .no-runs {
        text-align: center;
        padding: 3rem;
        color: #718096;
      }
      
      .no-runs h3 {
        margin-bottom: 0.5rem;
        color: #a0aec0;
      }
      
      .no-runs p {
        margin-bottom: 1.5rem;
      }
      
      .no-runs button {
        background: linear-gradient(135deg, #64ffda 0%, #38b2ac 100%);
        color: #1a1a2e;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(100, 255, 218, 0.3);
      }
      
      .no-runs button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(100, 255, 218, 0.4);
      }
      
      .empty-state {
        margin-top: 2rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border-radius: 8px;
        text-align: center;
      }
      
      .empty-state h4 {
        color: #a0aec0;
        margin-bottom: 0.5rem;
      }
      
      .empty-state p {
        color: #718096;
        font-size: 0.875rem;
        margin-bottom: 0;
      }
    </style>
  </main>
</body>
</html>`;

  fetchRuns();
  fetchScores();

  function renderRuns() {
    const container = document.getElementById("runs-container");
    if (!container) return;

    if (runs.length === 0) {
      container.innerHTML = `
      <div class="no-runs">
        <h3>No cached runs yet</h3>
        <p>Runs will appear here once benchmark tests complete.</p>
        <button id="trigger-refresh">🔄 Trigger Refresh</button>
      </div>
    `;
      return;
    }

    container.innerHTML = runs
      .map((run) => {
        const scores = getRunWithScores(run)
          .qualityScores as QualityScoresForAveraging;
        const avgScore = averageScore(scores);

        return `
      <article class="run-card">
        <div class="run-header">
          <h2 class="run-title">${run.model}</h2>
          <span class="run-id">${run.id}</span>
        </div>
        <div class="run-meta">
          <span>📅 ${formatDate(run.createdAt)}</span>
          <span>📊 Avg: ${formatScore(avgScore)}</span>
        </div>
        <div class="run-content">
          <p><strong>Prompt:</strong> ${run.prompt ? run.prompt.replace(/\n/g, " ") : "..."}</p>
          <p><strong>Completion:</strong> ${run.completion ? run.completion.replace(/\n/g, " ") : "..."}</p>
        </div>
        <div class="run-footer">
          <div class="score-grid">
            <div class="score-item">
              <span class="score-label">Accuracy</span>
              <span class="score-value">${formatScore(scores.accuracy)}</span>
              <div class="score-bar"><div class="score-fill" style="width: ${scores.accuracy * 100}%"></div></div>
            </div>
            <div class="score-item">
              <span class="score-label">Faithfulness</span>
              <span class="score-value">${formatScore(scores.faithfulness)}</span>
              <div class="score-bar"><div class="score-fill" style="width: ${scores.faithfulness * 100}%"></div></div>
            </div>
            <div class="score-item">
              <span class="score-label">Groundedness</span>
              <span class="score-value">${formatScore(scores.groundedness)}</span>
              <div class="score-bar"><div class="score-fill" style="width: ${scores.groundedness * 100}%"></div></div>
            </div>
            <div class="score-item">
              <span class="score-label">Instruction Following</span>
              <span class="score-value">${formatScore(scores.instructionFollowing)}</span>
              <div class="score-bar"><div class="score-fill" style="width: ${scores.instructionFollowing * 100}%"></div></div>
            </div>
            <div class="score-item">
              <span class="score-label">Reasoning</span>
              <span class="score-value">${formatScore(scores.reasoning)}</span>
              <div class="score-bar"><div class="score-fill" style="width: ${scores.reasoning * 100}%"></div></div>
            </div>
            <div class="score-item">
              <span class="score-label">Relevance</span>
              <span class="score-value">${formatScore(scores.relevance)}</span>
              <div class="score-bar"><div class="score-fill" style="width: ${scores.relevance * 100}%"></div></div>
            </div>
            <div class="score-item">
              <span class="score-label">Helpfulness</span>
              <span class="score-value">${formatScore(scores.helpfulness)}</span>
              <div class="score-bar"><div class="score-fill" style="width: ${scores.helpfulness * 100}%"></div></div>
            </div>
            <div class="score-item">
              <span class="score-label">Honesty</span>
              <span class="score-value">${formatScore(scores.honesty)}</span>
              <div class="score-bar"><div class="score-fill" style="width: ${scores.honesty * 100}%"></div></div>
            </div>
            <div class="score-item">
              <span class="score-label">Harmlessness</span>
              <span class="score-value">${formatScore(scores.harmlessness)}</span>
              <div class="score-bar"><div class="score-fill" style="width: ${scores.harmlessness * 100}%"></div></div>
            </div>
          </div>
        </div>
      </article>
    `;
      })
      .join("");
  }

  document.getElementById("refresh")?.addEventListener("click", handleRefresh);
  document
    .getElementById("trigger-refresh")
    ?.addEventListener("click", handleRefresh);

  const observer = new MutationObserver(renderRuns);
  const runsContainer = document.getElementById("runs-container");
  if (runsContainer) {
    observer.observe(runsContainer, {
      childList: true,
      subtree: true,
    });
  }

  renderRuns();
</script>
