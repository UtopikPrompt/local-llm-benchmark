{
  "name": "local-llm-benchmark",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "dbaeumer.vscode-jinja",
        "Ollama.ollama"
      ],
      "environmentVars": {
        "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
      },
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvInCurrentTerminal": true,
        "typescript.tsc.version": "auto",
        "files.eol": "\n",
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "postCreateCommand": "python3 -m pip install --upgrade pip setuptools wheel && pnpm config set store-dir ~/.pnpm-store && pnpm approve-builds --all && pnpm install",
  "forwardPorts": [8000, 5173],
  "remoteUser": "vscode"
}
