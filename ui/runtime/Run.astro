---
/**
 * ui/runtime/Run.astro — show a cached run's raw per-dimension scores.
 *
 * Reads raw per-dimension scores for the run and displays them unweighted
 * (dimension-weighting is DEFERRED, ADR-020).
 */
import { layout } from "./layouts/Default.astro";
import { getScores } from "../lib/cache.js";

interface Response {
  [dimension: string]: number;
}

const runId = Astro.params.runId;
const raw = (await getScores(runId)) as unknown as { scores: Response };
const data = raw.scores;
const dimensions = Object.keys(data);
const scores = Object.entries(data);
---
{
  layout {
    title = "Run Scores"
  }
}

<p><a href="/runtime/">← Back to runs</a></p>

<div class="run-scores">
  <h2>Raw Scores · {runId}</h2>
  <p class="note">Unweighted per-dimension scores. Dimension-weighting is deferred (ADR-020).</p>

  {#if dimensions.length === 0}
    <p class="empty">No scores cached for this run.</p>
  {:else}
    <table>
      <thead>
        <tr><th>Dimension</th>{#each dimensions as dim}<th>{dim}</th>{/each}</tr>
      </thead>
      <tbody>
        {#each scores as [dim, score]}
          <tr>
            <td>{dim}</td>
            <td>{score}</td>
          </tr>
        {/each}
      </tbody>
    </table>
  {/if}
</div>

<style>
  .run-scores h2 {
    margin: 0;
  }
  .note {
    color: #666;
    font-size: 13px;
  }
  .empty {
    color: #777;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 14px;
  }
  th, td {
    border: 1px solid #d0d0d0;
    padding: 6px 10px;
    text-align: left;
  }
  th {
    background: #f0f0f0;
  }
  a {
    color: #0366d6;
  }
</style>
