---
/**
 * Shared layout for the cached-run runtime pages.
 */
interface Props {
  title?: string;
}
const { title = "local-llm-benchmark" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="local-llm-benchmark UI runtime" />
		<title>{title} · local-llm-benchmark</title>
	</head>
	<body>
		<header class="header">
			<h1>local-llm-benchmark</h1>
			<nav>
				<a href="/runtime/">Runs</a>
				<a href="/runtime/run/{runId}">Run Detail</a>
			</nav>
		</header>
		<main class="content">
			<slot />
		</main>
	</body>
</html>
