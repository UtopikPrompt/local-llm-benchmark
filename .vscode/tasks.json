{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Vite Server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "➜  Local"
        },
        "pattern": {
          "regexp": ".*"
        }
      }
    },
    {
      "label": "Stop Vite Server",
      "type": "shell",
      "command": "echo 'Stopping Vite'",
      "problemMatcher": [],
      "dependsOn": ["Start Vite Server"],
      "presentation": {
        "reveal": "never",
        "close": true
      }
    }
  ]
}
