#!/usr/bin/env bash
#
# Launch the Local LLM Benchmark dashboard from the project root.
#
# Usage:
#   ./run                          # dashboard on 127.0.0.1:8000
#   ./run --host 0.0.0.0 --port 8000
#   ./run --config config.yaml --serve   # same as above when config.yaml exists
#
# Equivalent to:
#   python -m local_llm_benchmark --host "$@"
#
set -euo pipefail

cd "$(dirname "$0")"

python -m local_llm_benchmark --host "${1:-127.0.0.1}" --port "${2:-8000}" "$@"
