#!/bin/sh
#
# Launch the Local LLM Benchmark dashboard from the project root.
#
# Cross-platform launcher for Linux and macOS (uses POSIX sh). On Windows, use
# run.bat instead.
#
# Usage:
#   ./run                       # dashboard on 127.0.0.1:8000
#   ./run --host 0.0.0.0 --port 8000
#   ./run --config config.yaml --serve
#
# Any flags are forwarded to `python -m local_llm_benchmark`, which defaults to
# 127.0.0.1:8000 when none are given.
#
set -eu

cd "$(dirname "$0")"

exec python -m local_llm_benchmark "$@"
