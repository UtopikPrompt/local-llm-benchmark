# .env for maf_orchestrator.py
# Copy to `.env` and adjust for your environment. The AIDER_* keys are
# compatible with the .env used by the AIDER CLI.

# --- LLM backend (OpenAI-compatible endpoint) ---
# Base URL of the OpenAI-compatible /v1 endpoint.
LLM_BASE_URL=http://localhost:11434/v1
# API key; Ollama accepts an arbitrary token such as "ollama".
LLM_API_KEY=ollama

# --- Pipeline configuration ---
# Root folder of the project the orchestrator should modify.
TARGET_PROJECT_PATH=.
# Test command used to validate each vertical slice.
TEST_COMMAND=pytest engine/tests/
# Plan file that lists the vertical slices to implement.
PLAN_FILE_PATH=./docs/plan.md