{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "start-server",
      "command": "pnpm run dev",
      "isBackground": true,
      "group": "test",
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(ready in|Local:).*"
        }
      },
      "presentation": {
        "reveal": "never",
        "close": true,
        "panel": "shared"
      }
    },
    {
      "label": "terminate-server",
      "type": "shell",
      "command": "echo ${input:terminate}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "close": true,
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
