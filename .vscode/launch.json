{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Dashboard in Editor",
      "type": "debugpy",
      "request": "launch",
      "module": "local_llm_benchmark",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoReload": {
        "enable": true
      }
    },
    {
      "name": "Debug Dashboard in Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8000",
      "preLaunchTask": "start-server"
    },
    {
      "name": "Debug Dashboard in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:8000",
      "preLaunchTask": "start-server"
    }
  ],
  "compounds": [
    {
      "name": "UI + Server (Python + Browser)",
      "configurations": ["Debug Dashboard in Editor", "Debug Dashboard in Browser"]
    }
  ]
}
