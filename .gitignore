# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Installed package metadata generated by pip/setuptools
.local_llm_benchmark.egg-info/

# Test & coverage artifacts
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
htmlcov.xml

# Environments
.env
.venv/
venv/
env/
ENV/
venvs/
envs/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.mypy/
mypy.ini
pytype/

# Coverage data
*.gcda
*.gcno
*.gcov

# Kernel / Jupyter
.ipynb_checkpoints/

# Python bytecode
*.pyc
*.pyo

# ---------------------------------------------------------------------------
# Node.js / npm (added by devcontainer postCreateCommand.sh)
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# Frontend build outputs (bundled by build_frontend.py)
# ---------------------------------------------------------------------------
src/app/ui/main.js
src/app/ui/*.js.map

# ---------------------------------------------------------------------------
# Data & results
# ---------------------------------------------------------------------------
# Generated benchmark result files
benchmark_results.csv
benchmark_results.csv.json
# Default report output directory (see config.py DEFAULT_OUTPUT / default_output)
results/

