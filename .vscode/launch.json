{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Dashboard in Editor",
      "type": "editor-browser",
      "request": "launch",
      "url": "http://localhost:5173",
      "preLaunchTask": "start-server",
      "postDebugTask": "terminate-server"
    },
    {
      "name": "Debug Dashboard in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "preLaunchTask": "start-server"
    }
  ],
  "compounds": [
    {
      "name": "Dashboard in Browser",
      "configurations": [
        "Debug Dashboard in Editor",
        "Debug Dashboard in Edge"
      ],
      "stopAll": true
    }
  ]
}
