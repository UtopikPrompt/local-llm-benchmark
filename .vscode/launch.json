{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "JS: Debug with Backend",
      "type": "node",
      "request": "attach",
      "smartStep": true,
      "autoAttachChildProcesses": true,
      "outFiles": [
        "**/*.js",
        "**/astro.config.mjs",
        "**/astro.config.cjs"
      ],
      "skipFiles": [
        "**/node_modules/**"
      ],
      "port": 9230,
      "preLaunchTask": "Start All Servers",
      "sourceMaps": true,
      
    }
  ]
}
